#!/bin/zsh

function shortcut() {
  yes | cp -rf $1/$2 ~/.shortcuts/$(echo $2 | sed 's/\.sh//')
}

function task() {
  yes | cp -rf $1/$2 ~/.shortcuts/tasks/$(echo $2 | sed 's/\.sh//')
}

shortcut ~/Dev/sh/get-repos get-repos.sh
shortcut ~/Dev/sh/universal-setup setup.sh
shortcut ~/Dev/sh/nogit nogit.sh

task ~/Dev/sh/work-sched work-sched
task ~/Dev/python/Organize-by-extensions main.py

cd ~/.shortcuts
git pull
if git status | grep "modified" &> /dev/null; then
  git add .
  git commit -m "update shortcuts"
  git push
fi
